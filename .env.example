# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# --- Database ---
# Neon connection string. Dashboard -> Connect -> copy the connection
# string. Either pooled or direct works for the app itself; the direct
# one (no "-pooler" in the hostname) is needed for schema tooling.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# --- Server ---
PORT=4000
NODE_ENV=development
# Only this origin may call the API. Must match where the frontend runs.
WEB_ORIGIN=http://localhost:3000

# --- Authentication ---
# Signs login tokens. Any long random string; generate a fresh one per
# environment and never reuse the production value locally.
#
# PowerShell:
#   $b = New-Object byte[] 32
#   (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b)
#   [Convert]::ToBase64String($b)
#
# Changing this logs everyone out - existing tokens stop verifying.
AUTH_SECRET="replace-me"

# --- AI service ---
# The AI developer's Python service. Their hosted URL, or
# http://localhost:7860 if running it yourself.
#
# Optional: the server still boots without it, and answer endpoints
# return a clear "not connected" message rather than crashing.
AI_SERVICE_URL=http://localhost:7860

# --- Payments (Razorpay) ---
# Dashboard -> switch to TEST mode -> Account & Settings -> API Keys.
#
# The secret is shown ONCE, when the key is generated. If it's lost the
# key must be regenerated.
#
# Never put live keys (rzp_live_...) here. They move real money, and
# test transactions would mix into the foundation's live records. Live
# keys belong on the production server only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me

# Set when creating the webhook in Razorpay's dashboard - you choose
# this value. Used to verify webhooks genuinely came from Razorpay.
# Without it, anyone who found the webhook URL could grant themselves a
# paid plan.
RAZORPAY_WEBHOOK_SECRET=replace-me

# The Rs 9 monthly plan, created by hand in Razorpay's dashboard
# (Subscriptions -> Plans). Their API needs the plan to exist on their
# side before anyone can subscribe. Not a secret.
RAZORPAY_EARLY_BIRD_PLAN_ID=plan_replace_me
